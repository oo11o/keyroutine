{
  "schemaVersion": 2,
  "sites": [
    { "id": "app", "name": "app.example.com", "patterns": ["app.example.com"] },
    { "id": "orders", "name": "/orders", "patterns": ["app.example.com/orders"] },
    { "id": "docs", "name": "docs.example.org", "patterns": ["docs.example.org"] }
  ],
  "routines": [
    {
      "id": "test-login",
      "name": "Fill test login",
      "binding": { "code": "Digit1", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "siteId": null,
      "steps": [
        { "id": "s1", "type": "inputToSelector", "selector": "#email", "value": "qa@example.com" },
        { "id": "s2", "type": "inputToSelector", "selector": "#password", "value": "demo-password" },
        { "id": "s3", "type": "clickBySelector", "selector": "button[type=\"submit\"]" }
      ]
    },
    {
      "id": "cheatsheet",
      "name": "Show my hotkeys",
      "binding": { "code": "Digit0", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "siteId": null,
      "steps": [{ "id": "s1", "type": "popup", "title": "KeyRoutine hotkeys", "body": "$routines" }]
    },
    {
      "id": "order-json",
      "name": "Order as JSON",
      "binding": { "code": "Digit2", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "siteId": "app",
      "steps": [
        { "id": "orderId", "type": "readBySelector", "selector": "#order-id" },
        { "id": "order", "type": "fetchUrl", "url": "https://api.example.com/orders/$orderId" },
        { "id": "s3", "type": "popupJson", "title": "Order $orderId", "body": "$order" }
      ]
    },
    {
      "id": "save-reload",
      "name": "Save, then back to the list",
      "binding": { "code": "Digit3", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "siteId": "app",
      "steps": [
        { "id": "s1", "type": "clickBySelector", "selector": "#save" },
        { "id": "s2", "type": "wait", "ms": 800 },
        { "id": "s3", "type": "openUrlInCurrentTab", "url": "/orders" }
      ]
    },
    {
      "id": "order-new-tab",
      "name": "Open this order in a new tab",
      "binding": { "code": "Digit4", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": true,
      "siteId": "orders",
      "steps": [
        { "id": "orderId", "type": "readBySelector", "selector": "#order-id" },
        { "id": "s2", "type": "openUrlInNewTab", "url": "https://app.example.com/orders/$orderId/print" }
      ]
    },
    {
      "id": "doc-title",
      "name": "What page am I on",
      "binding": { "code": "Digit5", "ctrl": true, "alt": true, "shift": false, "meta": false },
      "enabled": false,
      "siteId": "docs",
      "steps": [
        { "id": "heading", "type": "readBySelector", "selector": "h1" },
        { "id": "s2", "type": "popup", "title": "$title", "body": "$heading\n\n$url" }
      ]
    }
  ]
}
